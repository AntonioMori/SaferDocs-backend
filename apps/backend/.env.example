# =============================================================================
# SaferDocs API: variáveis de ambiente
# -----------------------------------------------------------------------------
# Copie para `.env` (que é ignorado pelo git) e preencha. Para gerar um `.env`
# de desenvolvimento com segredos aleatórios:
#     uv run python scripts/generate_env.py
# Nenhum valor real deve ser escrito neste arquivo.
# =============================================================================

# Ambiente: development | test | production
APP_ENV=development

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Usadas pelo container do Postgres no docker-compose.
POSTGRES_USER=saferdocs
POSTGRES_PASSWORD=
POSTGRES_DB=saferdocs
# URL usada pela API. Dentro do docker-compose o host é `db`; rodando a API
# fora do Docker, use `localhost`.
DATABASE_URL=postgresql+psycopg://saferdocs:<senha>@db:5432/saferdocs

# -----------------------------------------------------------------------------
# JWT (REQ-17/18): par de chaves ES256 (ECDSA P-256)
# -----------------------------------------------------------------------------
# PEM inteiro codificado em base64 numa única linha.
JWT_PRIVATE_KEY_PEM_B64=
JWT_PUBLIC_KEY_PEM_B64=
# Valor do claim `iss`.
JWT_ISSUER=saferdocs
# Validade do access token em segundos (REQ-18: 15 min).
ACCESS_TOKEN_TTL_SECONDS=900
# Validade do refresh token em segundos (REQ-19: 7 dias).
REFRESH_TOKEN_TTL_SECONDS=604800

# -----------------------------------------------------------------------------
# Segredos do sistema (base64 de 32 bytes aleatórios cada)
# -----------------------------------------------------------------------------
# Senha mestra: deriva as chaves que cifram o segredo do TOTP (REQ-12) e as
# chaves privadas de assinatura dos usuários (REQ-45).
MASTER_KEY=
# Chave HMAC para os hashes de IP e User-Agent (REQ-26/27) e dos códigos de
# recuperação (REQ-14).
HASH_PEPPER=

# -----------------------------------------------------------------------------
# CORS (REQ-31..36)
# -----------------------------------------------------------------------------
# Origens permitidas, separadas por vírgula. Nunca use `*`.
CORS_ALLOWED_ORIGINS=http://localhost:3039
# Cache da preflight em segundos (REQ-36).
CORS_MAX_AGE_SECONDS=600

# -----------------------------------------------------------------------------
# WebAuthn / passkeys (REQ-06..10)
# -----------------------------------------------------------------------------
# rpId: domínio exato da aplicação, sem esquema nem porta (REQ-09).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=SaferDocs
# Origem completa do frontend (esquema + host + porta).
WEBAUTHN_ORIGIN=http://localhost:3039

# -----------------------------------------------------------------------------
# Login (REQ-03/05) e rate limit da verificação (REQ-53)
# -----------------------------------------------------------------------------
# Falhas consecutivas até bloquear a conta, e duração do bloqueio.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limites no formato "<quantidade>/<second|minute|hour>".
RATE_LIMIT_LOGIN_PER_IP=10/minute
RATE_LIMIT_LOGIN_PER_ACCOUNT=5/minute
RATE_LIMIT_VERIFY_PER_IP=10/minute

# -----------------------------------------------------------------------------
# PDF (REQ-61/62)
# -----------------------------------------------------------------------------
# Tamanho máximo do upload em MB.
MAX_UPLOAD_MB=20
# Socket Unix do pdf-worker isolado e timeout de cada operação.
PDF_WORKER_SOCKET=/run/pdf/worker.sock
PDF_WORKER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Cookies (REQ-20)
# -----------------------------------------------------------------------------
# Atributo Secure do cookie de refresh. Mantenha true (localhost é contexto
# seguro nos navegadores).
COOKIE_SECURE=true
