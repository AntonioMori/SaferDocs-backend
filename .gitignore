# --- Variáveis de Ambiente e Segredos (RNF-07) ---
# Qualquer arquivo .env fica fora do git; só o modelo documentado é versionado.
.env
.env.*
!.env.example
*.pem
*.key
keys/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node.js ---
node_modules/
dist/
build/
coverage/
.npm
.yarn

# --- IDEs e Editores ---
.vscode/
.idea/
*.swp
*.swo

# --- Sistema Operacional ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
